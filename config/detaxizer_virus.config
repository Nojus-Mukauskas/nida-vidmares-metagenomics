workDir = '/data/nextflow/detaxizer/detax_virus/work'

executor {
  cpus   = 128
  memory = 360.GB
}

process {
  executor = 'local'

  withName: 'FASTP' {
    ext.args = '--cut_right --cut_window_size 4 --correction --detect_adapter_for_pe --trim_poly_g'
  }

  withName: 'BBMAP_BBDUK' {
    ext.args = 'qhdist=1'
    time = '48h'
  }

  withName: 'KRAKEN2_KRAKEN2' {
    cpus     = 128
    memory   = 360.GB
    maxForks = 1
    ext.args = '--confidence 0.2 --minimum-hit-groups 3'
  }

  withName: 'ISOLATE_KRAKEN2_IDS' {
    time = '24h'
  }
}
