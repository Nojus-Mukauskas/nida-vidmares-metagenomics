workDir = '/data/nextflow/detaxizer/work'

executor {
  cpus   = 128
  memory = 360.GB
}

process {
  executor = 'local'
   time = 96.h

  withName: 'FASTP' {
    ext.args = '--cut_right --cut_window_size 4 --correction --detect_adapter_for_pe --trim_poly_g'
  }

  withName: 'BBMAP_BBDUK' {
    ext.args = 'hdist=1'
  }

    withName: '.*KRAKEN2.*' {
    cpus   = 128
    memory = 360.GB
    maxForks = 1
    ext.args = '--confidence 0.2 --minimum-hit-groups 3'
  }
}