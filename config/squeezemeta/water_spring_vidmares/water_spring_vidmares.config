#!/usr/bin/env bash

PROJECT="water_spring_vidmares"

/data/miniforge3/envs/squeezemeta_env/bin/SqueezeMeta.pl \
  -m coassembly \
  -p /data/squeezemeta/FINAL_PCoA/water_spring_vidmares/${PROJECT} \
  -s /data/squeezemeta/FINAL_PCoA/water_spring_vidmares/${PROJECT}.samples \
  -f /data/nextflow/detaxizer/detax_virus/results_virus/filter/filtered \
  -d /data/databases/squeezemeta_db/db/ \
  -a megahit \
  --doublepass \
  --nobins \
  --nopfam \
  -t 20 \
  -b 9 \
  -assembly_options "--tmp-dir /data/squeezemeta/FINAL_PCoA/water_spring_vidmares/assembly_tmp -m 0.9 --mem-flag 1 --presets meta-sensitive"