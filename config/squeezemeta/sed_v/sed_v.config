#!/usr/bin/env bash

PROJECT="sed_v"

/data/miniforge3/envs/squeezemeta_env/bin/SqueezeMeta.pl \
  -m coassembly \
  -p /data/squeezemeta/FINAL_PCoA/sediments_v/${PROJECT} \
  -s /data/squeezemeta/FINAL_PCoA/sediments_v/${PROJECT}.samples \
  -f /data/nextflow/detaxizer/detax_virus/results_virus/filter/filtered \
  -d /data/databases/squeezemeta_db/db/ \
  -a megahit \
  --doublepass \
  --nobins \
  -t 12 \
  -b 1 \
  -assembly_options "-t 96 --tmp-dir /data/squeezemeta/FINAL_PCoA/sediments_v/assembly_tmp -m 0.80 --mem-flag 1 --presets meta-sensitive"
